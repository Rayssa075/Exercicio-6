#include <iostream>
using namespace std;
int main() {
   int v[5];
   cout<<"Insira os valores do seu vetor: ";
   for(int i=0; i<5; i++){
       cin>>v[i];
   }
   
   for(int i=0; i<5/2; i++){
       int invertido=v[i];
       v[i]=v[4-i];
       v[4-i]= invertido;
   }
   cout<<"O vetor invertido é: ";
   for(int i=0; i<5; i++){
       cout<<v[i]<< " ";
   }

    return 0;
}
