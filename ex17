#include <iostream>
using namespace std;

int main() {
    int v[20], i, x;

    for(i = 0; i < 20; i++)
        cin >> v[i];

    for(i = 0; i < 10; i++) {
        x = v[i];
        v[i] = v[19 - i];
        v[19 - i] = x;
    }

    for(i = 0; i < 20; i++)
        cout << v[i] << " ";

    return 0;
}
