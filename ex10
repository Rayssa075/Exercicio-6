#include <iostream>
using namespace std;

int main(){
    int v1[10], v2[10];

    cout<<"Insira os valores do primeiro vetor: ";
    for(int i=0; i<10; i++){
        cin>>v1[i];
    }
    
    cout<<"Insira os valores do segundo vetor: ";
    for(int i=0; i<10; i++){
        cin>>v2[i];
    }
    
    // INTERSEÇÃO
    cout<<"Interseção: ";
    for(int i=0; i<10; i++){
        for(int j=0; j<10; j++){
            if(v1[i]==v2[j]){
                cout<<v1[i]<<" ";
                break;
            }
        }
    }

    // UNIÃO
    cout<<"\nUniao: ";
    for(int i=0; i<10; i++){
        cout<<v1[i]<<" ";
    }

    for(int i=0; i<10; i++){
        bool existe = false;

        for(int j=0; j<10; j++){
            if(v2[i] == v1[j]){
                existe = true;
                break;
            }
        }

        if(!existe){
            cout<<v2[i]<<" ";
        }
    }

    // DIFERENÇA
    cout<<"\nDiferenca (v1 - v2): ";
    for(int i=0; i<10; i++){
        bool existe = false;

        for(int j=0; j<10; j++){
            if(v1[i] == v2[j]){
                existe = true;
                break;
            }
        }

        if(!existe){
            cout<<v1[i]<<" ";
        }
    }

    return 0;
}
