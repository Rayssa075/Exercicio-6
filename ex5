#include <iostream>
using namespace std;
int main ( ) {
    int v1[10], v2[10], vr[10];
    
    cout<<"Insira os valores para o primeiro vetor: ";
    for(int i=0; i<10; i++){
        cin>> v1[i];
    }
    
    cout<< "Insira os valores para o segundo vetor: ";
    for(int i=0; i<10; i++){
        cin>>v2[i];
    }
    
    for(int i=0; i<10; i++){
        vr[i]=v1[i]*v2[i];
    }
    
    cout<<"o vetor resultante é "<< endl;
    for(int i=0; i<10; i++){
        cout<<vr[i] << " ";
    }
    
    return 0;
}
