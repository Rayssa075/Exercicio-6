#include <iostream>
using namespace std;

int main() {
    int A[10], B[10];
    int i, j = 0;

    for(i = 0; i < 10; i++) {
        cout << "Digite um valor: ";
        cin >> A[i];
    }


    for(i = 0; i < 10; i++) {
        if(A[i] > 0) {
            B[j] = A[i];
            j++;
        }
    }

    cout << "Vetor B:";
    for(i = 0; i < j; i++) {
        cout << B[i] << " ";
    }

    return 0;
}
