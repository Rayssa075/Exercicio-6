#include <iostream>
using namespace std;
int main ( ) {
    int v[6];
     for (int i =0; i<6; i++){
         cout <<"Digite o valor do v ["<<i<<"] ";
         cin >> v[i];
     }
     cout<<endl;
     
     cout << "Os valores digitados, foram:";
      for (int i =0; i<6; i++){
         cout << v[i] <<" ";
      }
      cout<<endl;
      
    int quanPares =0;
    int quanImpares = 0;
    
    cout << "Numeros Pares:";
     for (int i =0; i<6; i++){
         if ( v[i] % 2 ==0){
             cout << v[i]<< " ";
             quanPares++;
         }
     }
     cout<<endl;
    
    cout << "Numeros Impares:";
     for (int i =0; i<6; i++){
         if ( v[i] % 2 !=0){
             cout << v[i]<< " ";
             quanImpares++;
         }
     }
     cout<<endl;
     
    cout<< "Quantidade de numeros Pares: " << quanPares<<endl;
    cout<<endl;
    cout<< "Quantidade de numeros Impares: " << quanImpares<<endl;
    
    return 0;
     }
    
     
