#include <iostream>
using namespace std;
int main ( ) {
    int A[5];
     for (int i =0; i<5; i++){
         cout <<"Digite o valor do vetor A   ["<<i<<"] ";
         cin >> A[i];
     }
     cout<<endl;
     
     cout << "Os valores digitados, foram:";
      for (int i =0; i<5; i++){
         cout << A[i] <<" ";
      }
